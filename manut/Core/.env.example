# Modelo do arquivo de segredos. Copie para manut\Core\secure\.env e preencha.
# O .env real nunca vai para o git (ver .gitignore).

# Contas locais do Windows
ADM01_PASSWORD=
ADMIN_PASSWORD=
STANDARD_USER_PASSWORD=

# Wi-Fi configurado logo apos a formatacao
WIFI_SSID=
WIFI_PASSWORD=
# WPA2PSK (WPA2-Personal) ou WPA3SAE (WPA3-Personal)
WIFI_AUTH=WPA2PSK

# Usuario Linux do WSL (WslUbuntuCustom.ps1)
WSL_USER_PASSWORD=
